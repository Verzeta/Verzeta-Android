<!--
  Auto Backup rules — used by Android Auto Backup (the Google Drive
  cloud backup that runs roughly daily on Wi-Fi + charging) to decide
  which app-private data survives uninstall and device migration.

  We explicitly include only the two prefs files we own:
    - verzeta_hosts.xml         host configs (id, name, endpoint, lastConnectedAt)
    - verzeta_remote_auth.xml   per-host pairing tokens

  Tokens are stored as plain UTF-8 in verzeta_remote_auth.xml — see the
  rationale in `storage/PrefsTokenStore.kt`. The user can revoke any
  device's token from Settings → Devices paired with this host, which
  invalidates the host-side row immediately.

  Everything else (Compose snapshots, gradle caches if any leak in,
  WebSocket scratch state) is excluded.
-->
<full-backup-content>
    <include domain="sharedpref" path="verzeta_hosts.xml" />
    <include domain="sharedpref" path="verzeta_remote_auth.xml" />
</full-backup-content>
