<!--
  Android 12+ data-extraction rules. Mirror the backup_rules.xml include
  set for both:
    - cloud-backup           Auto Backup to Google Drive
    - device-transfer        wired/wireless device-to-device migration

  Same prefs files, same rationale as in backup_rules.xml.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="verzeta_hosts.xml" />
        <include domain="sharedpref" path="verzeta_remote_auth.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="verzeta_hosts.xml" />
        <include domain="sharedpref" path="verzeta_remote_auth.xml" />
    </device-transfer>
</data-extraction-rules>
